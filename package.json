{
  "name": "marq-operations",
  "version": "1.0.0",
  "description": "Project MARQ: A secure, steganography-enabled tactical interface.",
  "type": "module",
  "main": "js/app.js",
  "scripts": {
    "predev": "node tools/generate-manifest.js",
    "dev": "vite",
    "start": "vite",
    "prebuild": "node tools/generate-manifest.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.mjs",
    "test:e2e": "python3 tests/verify_app.py",
    "lint": "eslint js/",
    "format": "prettier --write '**/*.{js,css,html,md}'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.41.0",
    "eslint": "^9.0.0",
    "globals": "^17.1.0",
    "prettier": "^3.2.4",
    "vite": "^7.3.1"
  },
  "private": true
}
